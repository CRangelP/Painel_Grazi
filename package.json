{
  "name": "painel-grazi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p . && node dist-js/index.js",
    "check-freshness": "tsc -p . && node dist-js/check-freshness.js",
    "test": "vitest run",
    "test:watch": "vitest",
