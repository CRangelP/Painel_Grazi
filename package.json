    "lint": "biome check",
    "format": "biome check --write"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/node": "^20.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
